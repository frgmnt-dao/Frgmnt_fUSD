# RPCs
MAINNET_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/your-api-key"
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/your-api-key"
MATIC_RPC_URL="https://polygon-mainnet.g.alchemy.com/v2/your-api-key"
MUMBAI_RPC_URL="https://polygon-mumbai.g.alchemy.com/v2/v3/your-api-key"

# Etherscan API keys
ETHERSCAN_API_KEY="api-key"
POLYGONSCAN_API_KEY="api-key"

# Credentials
MNEMONIC="your mnemonic"
PRIVATE_KEY=

# Deployment product selection (scripts/deploy_core_contracts.ts)
# Defaults to USD when unset — leave commented out unless deploying EUR.
# An uncommented but empty PRODUCT= is NOT the same as unset and will make the
# script throw, since it only falls back to USD when the variable is truly absent.
# PRODUCT=EUR

# EUR deployment (only used when PRODUCT=EUR)
# Must be the Chainlink EUR/USD feed for the target chain: USD per 1 EUR.
EUR_USD_FEED=

