{
    "plugins": ["prettier-plugin-solidity"],
    "trailingComma": "all",
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "useTabs": false,
    "printWidth": 100,
    "overrides": [
        {
            "files": "*.sol",
            "options": {
                "printWidth": 100,
                "tabWidth": 4,
                "singleQuote": false,
                "bracketSpacing": true
            }
        },
        {
            "files": ["*.ts", "*.tsx"],
            "options": {
                "tabWidth": 2,
                "singleQuote": true
            }
        }
    ]
}
